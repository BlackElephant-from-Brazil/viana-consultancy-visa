# Netlify response headers for every page and file of visa.vianaconsultancy.com.
#
# Content-Security-Policy is enforced only with rules no third party relies on:
# no framing by other sites (clickjacking on the lead forms), no <base> or
# plugin injection, forms submit nowhere but here (they post with fetch).
#
# Content-Security-Policy-Report-Only is the full allowlist. Browsers only log
# what it would block (DevTools console), nothing breaks. Once the live console
# stays clean through a GTM / Google Ads / Calendly booking cycle, it can move
# into the enforced header. Inline scripts (GTM, GA4, Clarity, va_click_id)
# need 'unsafe-inline' until they move into files.
#
# When a new third party is added to the page, add its hosts here too.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), serial=(), hid=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.google-analytics.com https://*.clarity.ms https://assets.calendly.com https://challenges.cloudflare.com https://www.googleadservices.com https://*.doubleclick.net https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://black-elephant.app.n8n.cloud https://analytics.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com https://www.google.com https://google.com https://www.google.pt https://www.googleadservices.com https://*.doubleclick.net https://challenges.cloudflare.com; frame-src https://calendly.com https://challenges.cloudflare.com https://www.googletagmanager.com https://*.doubleclick.net https://www.google.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'

# Fonts never change under the same name: cache them for a year. Images for a week, so a
# replaced photo shows up within days (better: give a new photo a new file name).
/b/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/b/img/*
  Cache-Control: public, max-age=604800
/assets/images/*
  Cache-Control: public, max-age=604800
